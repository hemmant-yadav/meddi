# Meddibuddy Environment Configuration
# DISCLAIMER: Meddibuddy is an educational medical report explainer tool.
# Never hardcode secret keys in client-side code.

# Vite App Configuration
VITE_APP_NAME="Meddibuddy"
VITE_APP_TAGLINE="Scan. Understand. Act."

# Firebase Client Configuration (Frontend Auth & Storage triggers)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
