# Backend / Server-side Cloud Functions (Server-side only for Gemini, Document AI, Translation)
# Gemini API Key MUST be kept server-side only in Cloud Functions / Backend
VITE_API_BASE_URL="http://localhost:5001/meddibuddy-project/us-central1/api"
